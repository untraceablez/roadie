# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Ticketmaster Discovery API key (https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=

# Optional: Bandsintown app id (used for artist watchlist lookups)
BANDSINTOWN_APP_ID=

# Optional scrapers (Songkick, FestivalGuide). Off by default; check each site's ToS first.
ENABLE_SCRAPERS=false

DATABASE_PATH=./data/roadie.db
POLL_INTERVAL_MINUTES=30
LOG_LEVEL=info
